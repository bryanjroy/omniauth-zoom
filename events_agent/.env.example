# Copy this to .env and fill in your values

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Your identity
OWNER_NAME=Your Name
OWNER_EMAIL=you@gmail.com
OWNER_PHONE=+16175550100

# Business email (the public inbox agents monitor)
BUSINESS_EMAIL=events@needhamcommunityevents.com
BUSINESS_PHONE=+17815550100

# Google Calendar (get from Google Calendar settings > Calendar ID)
GCAL_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# OpenWeatherMap (free tier — openweathermap.org)
OPENWEATHER_API_KEY=your_key_here

# SendGrid (optional fallback mailer)
SENDGRID_API_KEY=SG....

# Twilio (for SMS alerts to owner)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+15005550006
